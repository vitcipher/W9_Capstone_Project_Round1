# Copy to .env and fill in real values locally. Never commit .env.

OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capstone-round1-property-extraction
LANGSMITH_TRACING=true
# Uncomment if your LangSmith workspace is EU-hosted - if trace ingestion gets
# a 403 with an otherwise-valid key, this is almost always why (this project's
# own workspace needed it - see langsmith/README.md "Setup gotcha").
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Used only by the n8n workflow (n8n/workflow_documentation.md) - set as an
# HTTP Header Auth credential inside n8n itself, not read from this file
# directly, but listed here since it's the same key as OPENAI_API_KEY above.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/document-upload
