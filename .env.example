# Copy to .env and fill in real values locally. Never commit .env.
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=capstone-round1-property-extraction
LANGSMITH_TRACING=true
# Uncomment if your LangSmith workspace is EU-hosted - if trace ingestion gets
# a 403 with an otherwise-valid key, this is almost always why (this project's
# own workspace needed it - see langsmith/README.md "Setup gotcha").
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
N8N_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/document-upload

# Bank Feed tab (app/bank_feed.py) - stretch feature, optional.
# Register an app at https://enablebanking.com/cp/applications with
# redirect URL http://localhost:8501 (their Sandbox explicitly supports
# plain http://localhost - see app/bank_feed.py docstring), then add
# test accounts under the "Mock ASPSP" tab in their Control Panel.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=http://localhost:8501
